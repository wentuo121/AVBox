// 极光渐变：紫蓝青渐变主色 + 层叠轮播 + 毛玻璃分类栏 + 站源标题 + 一排工具按钮。
import core.widgets;
import peek.home;

// ---------------------------------------------------------------- 多风格

widget skins {
  aurora: { name: "极光渐变", bg: 0xFF0F0C29, card: 0xFF24243E, ink: 0xFFFFFFFF, ink2: 0xFFB8B8D0, accent: 0xFF6C5CE7 },
  peach:  { name: "蜜桃渐变", bg: 0xFFFFF5F0, card: 0xFFFFFFFF, ink: 0xFF3D2E2A, ink2: 0xFFA89B95, accent: 0xFFFF6B9D },
  glow:   { name: "流光", dynamic: true },
} = SizedBoxShrink();

// ---------------------------------------------------------------- 分类胶囊（毛玻璃）

widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: PeekGlass(
    blur: 14.0,
    radius: 18.0,
    tintColor: switch args.item.selected {
      true: 0xD9FFFFFF,
      false: 0x1EFFFFFF,
    },
    borderColor: switch args.item.selected {
      true: 0x40FFFFFF,
      false: 0x18FFFFFF,
    },
    child: Container(
      height: 30.0,
      padding: [ 14.0, 0.0 ],
      alignment: { x: 0.0, y: 0.0 },
      child: Text(
        text: args.item.typeName,
        maxLines: 1,
        overflow: "ellipsis",
        style: {
          color: switch args.item.selected {
            true: 0xFF1F1D1A,
            false: 0xF5FFFFFF,
          },
          fontSize: 12.0,
          fontWeight: "w800",
          height: 1.0,
        },
      ),
    ),
  ),
);

// ---------------------------------------------------------------- 筛选面板里的选项

widget FilterOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: PeekGlass(
    blur: 14.0,
    radius: 13.0,
    tintColor: switch args.item.selected {
      true: 0xD9FFFFFF,
      false: 0x18FFFFFF,
    },
    borderColor: switch args.item.selected {
      true: 0x38FFFFFF,
      false: 0x16FFFFFF,
    },
    child: Container(
      height: 26.0,
      padding: [ 9.0, 0.0 ],
      alignment: { x: 0.0, y: 0.0 },
      child: Text(
        text: args.item.name,
        maxLines: 1,
        overflow: "ellipsis",
        style: {
          color: switch args.item.selected {
            true: 0xFF251C19,
            false: 0xF2FFFFFF,
          },
          fontSize: 10.0,
          fontWeight: "w700",
          height: 1.0,
        },
      ),
    ),
  ),
);

widget FilterLabel = PeekGlass(
  blur: 12.0,
  radius: 13.0,
  tintColor: 0x12FFFFFF,
  borderColor: 0x10FFFFFF,
  child: Container(
    height: 28.0,
    padding: [ 10.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    child: Text(
      text: args.name,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: 0xCCFFFFFF,
        fontSize: 10.0,
        fontWeight: "w800",
        height: 1.0,
      },
    ),
  ),
);

widget FilterRow = Row(
  children: [
    Expanded(
      child: ListView(
        scrollDirection: "horizontal",
        children: [
          ...for option in args.group.options:
            Padding(
              padding: [ 0.0, 1.0, 8.0, 1.0 ],
              child: FilterOption(item: option),
            ),
        ],
      ),
    ),
    switch args.group.canExpand {
      true: Padding(
        padding: [ 6.0, 1.0, 0.0, 1.0 ],
        child: TinyToolButton(
          icon: data.home.icons.expand,
          action: event "showFilterPicker" { key: args.group.key },
        ),
      ),
      false: SizedBoxShrink(),
    },
  ],
);

// ---------------------------------------------------------------- 分类 + 筛选吸顶栏

widget CategoryHeader = Container(
  color: 0x00000000,
  child: Column(
    children: [
      Container(
        height: 54.0,
        padding: switch data.home.gridColumns {
          3: [ 12.0, 6.0, 12.0, 6.0 ],
          default: [ 16.0, 4.0, 16.0, 4.0 ],
        },
        child: PeekGlass(
          blur: 16.0,
          radius: 22.0,
          tintColor: 0x16111418,
          borderColor: 0x14FFFFFF,
          child: Container(
            padding: [ 8.0, 0.0 ],
            child: ListView(
              scrollDirection: "horizontal",
              children: [
                ...for item in data.home.classes:
                  Padding(
                    padding: [ 0.0, 6.0, 8.0, 6.0 ],
                    child: CategoryChip(item: item),
                  ),
              ],
            ),
          ),
        ),
      ),
      switch data.home.showFilters {
        true: Container(
          padding: switch data.home.gridColumns {
            3: [ 12.0, 4.0, 12.0, 12.0 ],
            default: [ 16.0, 5.0, 16.0, 10.0 ],
          },
          child: PeekGlass(
            blur: 18.0,
            radius: 18.0,
            tintColor: 0x1811161B,
            borderColor: 0x18FFFFFF,
            child: Container(
              height: data.home.filterPanelHeight,
              padding: [ 10.0, 4.0 ],
              child: ListView(
                primary: false,
                padding: [ 0.0 ],
                children: [
                  ...for group in data.home.filters:
                    Container(
                      height: 28.0,
                      child: FilterRow(group: group),
                    ),
                ],
              ),
            ),
          ),
        ),
        false: SizedBoxShrink(),
      },
    ],
  ),
);

// ---------------------------------------------------------------- 工具按钮（毛玻璃）

widget TinyToolButton = GestureDetector(
  onTap: args.action,
  child: PeekGlass(
    blur: 14.0,
    radius: 12.0,
    tintColor: 0x20FFFFFF,
    borderColor: 0x1EFFFFFF,
    child: Container(
      width: 23.0,
      height: 26.0,
      alignment: { x: 0.0, y: 0.0 },
      child: Icon(
        icon: args.icon,
        fontFamily: "MaterialIcons",
        size: 13.0,
        color: 0xF7FFFFFF,
      ),
    ),
  ),
);

// ---------------------------------------------------------------- section bar：站源名 + 一排按钮

widget SectionTitleSource = GestureDetector(
  onTap: event "showSourcePicker" {},
  child: Column(
    mainAxisSize: "min",
    crossAxisAlignment: "start",
    children: [
      Text(
        text: data.home.source.name,
        maxLines: 1,
        overflow: "ellipsis",
        style: {
          color: 0xFFFFFFFF,
          fontSize: 19.0,
          fontWeight: "w900",
          shadows: [ { color: 0x33000000, blurRadius: 6.0 } ],
        },
      ),
      Padding(
        padding: [ 0.0, 3.0, 0.0, 0.0 ],
        child: Text(
          text: [ data.home.totalLabel, " 部内容 · 点击站源名切换站源" ],
          maxLines: 1,
          overflow: "ellipsis",
          style: {
            color: 0xAFFFFFFF,
            fontSize: 10.0,
            letterSpacing: 0.4,
          },
        ),
      ),
    ],
  ),
);

widget SectionActionsCompact = Row(
  mainAxisAlignment: "end",
  children: [
    switch data.home.hasFilters {
      true: Padding(
        padding: [ 0.0, 0.0, 3.0, 0.0 ],
        child: TinyToolButton(
          icon: data.home.icons.filter,
          action: event "toggleFilters" {},
        ),
      ),
      false: SizedBoxShrink(),
    },
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.api,
        action: event "showApiConfigPicker" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.search,
        action: event "openSearch" {},
      ),
    ),
    Padding(
      padding: [ 0.0, 0.0, 3.0, 0.0 ],
      child: TinyToolButton(
        icon: data.home.icons.layout,
        action: event "showDisplayStylePicker" {},
      ),
    ),
    TinyToolButton(
      icon: data.home.icons.refresh,
      action: event "refresh" {},
    ),
  ],
);

widget SectionBar = Container(
  color: 0x00000000,
  padding: switch data.home.gridColumns {
    3: [ 16.0, 8.0, 16.0, 10.0 ],
    default: [ 20.0, 5.0, 20.0, 8.0 ],
  },
  child: Row(
    children: [
      Expanded(child: SectionTitleSource()),
      Container(
        width: switch data.home.isLandscape {
          true: 312.0,
          false: 214.0,
        },
        height: 28.0,
        child: SectionActionsCompact(),
      ),
    ],
  ),
);

// ---------------------------------------------------------------- 轮播推荐卡

widget HeroSlide = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Container(
    margin: [ 4.0, 4.0, 4.0, 4.0 ],
    clipBehavior: "none",
    child: ClipRRect(
      borderRadius: [ { x: 20.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(
            url: args.item.pic,
            fit: "cover",
            placeholderColor: data.home.skin.card,
          ),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: 0.0, y: 1.0 },
                end: { x: 0.0, y: 0.0 },
                colors: [ 0xE6000000, 0x00000000 ],
              },
            },
          ),
          Positioned(
            left: 16.0,
            right: 16.0,
            bottom: 16.0,
            child: Column(
              mainAxisSize: "min",
              crossAxisAlignment: "start",
              children: [
                Text(
                  text: args.item.name,
                  maxLines: 2,
                  overflow: "ellipsis",
                  style: {
                    color: 0xFFFFFFFF,
                    fontSize: 20.0,
                    fontWeight: "w800",
                    shadows: [ { color: 0x8C000000, blurRadius: 20.0, offset: { x: 0.0, y: 2.0 } } ],
                  },
                ),
                Padding(
                  padding: [ 0.0, 4.0, 0.0, 0.0 ],
                  child: Text(
                    text: [ args.item.year, " · ", args.item.typeName ],
                    style: { color: 0xCCFFFFFF, fontSize: 12.0 },
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    ),
  ),
);

// ---------------------------------------------------------------- 海报卡片

widget YearBadge = switch args.item.year {
  "": SizedBoxShrink(),
  default: Container(
    padding: [ 8.0, 4.0 ],
    decoration: {
      type: "box",
      color: 0x99101318,
      borderRadius: [ { x: 12.0 } ],
    },
    child: Text(
      text: args.item.year,
      maxLines: 1,
      overflow: "ellipsis",
      style: {
        color: 0xF7FFFFFF,
        fontSize: 9.0,
        fontWeight: "w700",
      },
    ),
  ),
};

widget PosterCard = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      borderRadius: [ { x: 18.0 } ],
      color: 0x1AFFFFFF,
      boxShadow: [ { color: 0x2210151A, blurRadius: 14.0, offset: { x: 0.0, y: 10.0 } } ],
    },
    child: Column(
      crossAxisAlignment: "start",
      children: [
        Expanded(
          child: ClipRRect(
            borderRadius: [ { x: 18.0 }, { x: 18.0, y: 0.0 } ],
            child: Stack(
              fit: "expand",
              children: [
                T4Image(url: args.item.pic),
                Align(
                  alignment: { x: 1.0, y: -1.0 },
                  child: Padding(
                    padding: [ 10.0 ],
                    child: YearBadge(item: args.item),
                  ),
                ),
                switch args.item.remarks {
                  "": SizedBoxShrink(),
                  default: Align(
                    alignment: { x: 1.0, y: 1.0 },
                    child: Padding(
                      padding: [ 10.0 ],
                      child: Text(
                        text: args.item.remarks,
                        maxLines: 1,
                        overflow: "ellipsis",
                        textAlign: "right",
                        style: {
                          color: 0xF2FFFFFF,
                          fontSize: 10.0,
                          fontWeight: "w700",
                          shadows: [ { color: 0xAA000000, blurRadius: 10.0 } ],
                        },
                      ),
                    ),
                  ),
                },
              ],
            ),
          ),
        ),
        Container(
          padding: [ 10.0, 6.0, 10.0, 6.0 ],
          child: Text(
            text: args.item.name,
            maxLines: 1,
            overflow: "ellipsis",
            style: {
              color: 0xFFFFFFFF,
              fontSize: 12.0,
              fontWeight: "w800",
              height: 1.0,
            },
          ),
        ),
      ],
    ),
  ),
);

// ---------------------------------------------------------------- 空态

widget EmptyState = switch data.home.loading {
  true: Center(
    child: Text(
      text: "正在载入…",
      style: { color: 0xD9FFFFFF, fontSize: 13.0 },
    ),
  ),
  false: Center(
    child: Text(
      text: "暂无内容",
      style: { color: 0xC8FFFFFF, fontSize: 13.0 },
    ),
  ),
};

// ---------------------------------------------------------------- 首页根

widget root = Container(
  duration: 600,
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: 0.0, y: 0.0 },
      end: { x: 1.0, y: 1.0 },
      colors: switch data.home.skin.id {
        "peach": [ 0xFFFFF5F0, 0xFFFFE0EC, 0xFFE0F0FF ],
        default: [ 0xFF0F0C29, 0xFF302B63, 0xFF24243E ],
      },
    },
  },
  child: PeekStickyGrid(
    // hero
    heroHeight: switch data.home.hasRecommend {
      true: switch data.home.gridColumns {
        3: 220.0,
        4: 250.0,
        5: 280.0,
        6: 310.0,
        default: 200.0,
      },
      false: 0.0,
    },
    hero: switch data.home.hasRecommend {
      true: PeekCarousel(
        autoPlay: true,
        style: "stack",
        viewportFraction: 0.84,
        showIndicators: true,
        indicatorAlignment: "end",
        indicatorInset: 24.0,
        indicatorBottom: 14.0,
        activeColor: 0xFF6C5CE7,
        inactiveColor: 0x4DFFFFFF,
        stackScale: 0.86,
        stackOpacity: 0.5,
        stackOffset: 0.12,
        syncImmersivePalette: true,
        interval: 4500,
        children: [
          ...for item in data.home.home.recommend:
            HeroSlide(item: item),
        ],
      ),
      false: SizedBoxShrink(),
    },

    // pinnedHeader
    pinnedHeight: data.home.stickyHeaderHeight,
    pinnedHeader: CategoryHeader(),

    // sectionHeader
    sectionHeight: switch data.home.gridColumns {
      3: 70.0,
      default: 64.0,
    },
    sectionHeader: SectionBar(),

    // 下拉刷新
    onRefresh: event "refresh" {},
    refreshing: data.home.refreshing,
    refreshColor: 0xFF6C5CE7,
    refreshBackground: 0x00000000,

    // 网格
    crossAxisCount: data.home.gridColumns,
    childAspectRatio: 0.75,
    mainAxisSpacing: 12.0,
    crossAxisSpacing: 10.0,
    horizontalPadding: switch data.home.gridColumns {
      3: 16.0,
      default: 20.0,
    },
    bottomPadding: 106.0,

    // 空态
    empty: EmptyState(),

    // 子项
    children: [
      ...for item in data.home.items:
        PosterCard(item: item),
    ],
  ),
);
