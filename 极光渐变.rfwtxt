// 极光渐变：紫蓝青渐变主色 + 层叠轮播 + 分类胶囊 + 一排图标按钮。
import core.widgets;
import peek.home;

// ---------------------------------------------------------------- 多风格

widget skins {
  aurora: { name: "极光渐变", bg: 0xFF0F0C29, card: 0xFF24243E, ink: 0xFFFFFFFF, ink2: 0xFFB8B8D0, accent: 0xFF6C5CE7 },
  peach:  { name: "蜜桃渐变", bg: 0xFFFFF5F0, card: 0xFFFFFFFF, ink: 0xFF3D2E2A, ink2: 0xFFA89B95, accent: 0xFFFF6B9D },
  glow:   { name: "流光", dynamic: true },
} = SizedBoxShrink();

// ---------------------------------------------------------------- 海报（快速开始示例）

widget Poster = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Expanded(
        child: ClipRRect(
          borderRadius: [ { x: 10.0 } ],
          child: T4Image(
            url: args.item.pic,
            placeholderColor: data.home.skin.card,
          ),
        ),
      ),
      Padding(
        padding: [ 2.0, 6.0, 2.0, 0.0 ],
        child: Text(
          text: args.item.name,
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: data.home.skin.ink, fontSize: 13.0, fontWeight: "w600" },
        ),
      ),
      Padding(
        padding: [ 2.0, 0.0 ],
        child: Text(
          text: args.item.remarks,
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: data.home.skin.ink2, fontSize: 11.0 },
        ),
      ),
    ],
  ),
);

// ---------------------------------------------------------------- 分类胶囊（快速开始示例，选中态用渐变）

widget Chip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    margin: [ 0.0, 8.0, 8.0, 8.0 ],
    padding: [ 14.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: switch args.item.selected {
      true: {
        type: "box",
        gradient: {
          type: "linear",
          begin: { x: 0.0, y: 0.0 },
          end: { x: 1.0, y: 0.0 },
          colors: [ 0xFF6C5CE7, 0xFF0984E3, 0xFF00B894 ],
        },
        borderRadius: [ { x: 16.0 } ],
      },
      false: {
        type: "box",
        color: 0x00000000,
        borderRadius: [ { x: 16.0 } ],
      },
    },
    child: Text(
      text: args.item.typeName,
      style: {
        color: switch args.item.selected { true: 0xFFFFFFFF, false: data.home.skin.ink },
        fontSize: 14.0,
        fontWeight: switch args.item.selected { true: "w700", false: "w400" },
      },
    ),
  ),
);

// ---------------------------------------------------------------- 轮播推荐卡

widget HeroCard = GestureDetector(
  onTap: event "openRecommend" { index: args.index },
  child: Container(
    margin: [ 4.0, 4.0, 4.0, 4.0 ],
    clipBehavior: "none",
    child: ClipRRect(
      borderRadius: [ { x: 20.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(
            url: args.item.pic,
            fit: "cover",
            placeholderColor: data.home.skin.card,
          ),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: 0.0, y: 1.0 },
                end: { x: 0.0, y: 0.0 },
                colors: [ 0xE6000000, 0x00000000 ],
              },
            },
          ),
          Positioned(
            left: 16.0,
            right: 16.0,
            bottom: 16.0,
            child: Column(
              mainAxisSize: "min",
              crossAxisAlignment: "start",
              children: [
                Text(
                  text: args.item.name,
                  maxLines: 2,
                  overflow: "ellipsis",
                  style: { color: 0xFFFFFFFF, fontSize: 20.0, fontWeight: "w800" },
                ),
                Padding(
                  padding: [ 0.0, 4.0, 0.0, 0.0 ],
                  child: Text(
                    text: [ args.item.year, " · ", args.item.typeName ],
                    style: { color: 0xCCFFFFFF, fontSize: 12.0 },
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    ),
  ),
);

// ---------------------------------------------------------------- 首页根（严格对齐快速开始 Row 结构）

widget root = Container(
  duration: 600,
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: 0.0, y: 0.0 },
      end: { x: 1.0, y: 1.0 },
      colors: switch data.home.skin.id {
        "peach": [ 0xFFFFF5F0, 0xFFFFE0EC, 0xFFE0F0FF ],
        default: [ 0xFF0F0C29, 0xFF302B63, 0xFF24243E ],
      },
    },
  },
  child: PeekStickyGrid(
    // hero
    heroHeight: switch data.home.hasRecommend { true: 220.0, false: 0.0 },
    hero: switch data.home.hasRecommend {
      true: Container(
        padding: [ 14.0, 10.0, 14.0, 0.0 ],
        child: PeekCarousel(
          style: "stack",
          viewportFraction: 0.84,
          autoPlay: true,
          interval: 4500,
          showIndicators: true,
          indicatorAlignment: "end",
          activeColor: 0xFF6C5CE7,
          inactiveColor: 0x4DFFFFFF,
          stackScale: 0.86,
          stackOpacity: 0.5,
          stackOffset: 0.12,
          syncImmersivePalette: true,
          children: [
            ...for item in data.home.home.recommend:
              HeroCard(item: item, index: item.index),
          ],
        ),
      ),
      default: SizedBoxShrink(),
    },

    // pinnedHeader: Row = Expanded(胶囊横排) + 7 个图标按钮
    pinnedHeight: 52.0,
    pinnedHeader: Container(
      child: Row(
        children: [
          Expanded(
            child: ListView(
              scrollDirection: "horizontal",
              padding: [ 12.0, 0.0 ],
              children: [
                ...for item in data.home.classes:
                  Chip(item: item),
              ],
            ),
          ),
          GestureDetector(
            onTap: event "toggleFilters" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.filter, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
          GestureDetector(
            onTap: event "openSearch" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.search, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
          GestureDetector(
            onTap: event "refresh" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.refresh, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
          GestureDetector(
            onTap: event "openFavorite" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.favorite, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
          GestureDetector(
            onTap: event "showSourcePicker" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.source, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
          GestureDetector(
            onTap: event "showApiConfigPicker" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.api, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
          GestureDetector(
            onTap: event "cycleDisplayStyle" {},
            child: Container(
              width: 40.0,
              alignment: { x: 0.0, y: 0.0 },
              child: Icon(icon: data.home.icons.layout, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
            ),
          ),
        ],
      ),
    ),

    // sectionHeader 不显示
    sectionHeight: 0.0,
    sectionHeader: SizedBoxShrink(),

    // 下拉刷新
    onRefresh: event "refresh" {},
    refreshing: data.home.refreshing,
    refreshColor: 0xFF6C5CE7,
    refreshBackground: 0x00000000,

    // 空态
    empty: Center(
      child: Text(
        text: switch data.home.loading { true: "正在载入…", false: "暂无内容" },
        style: { color: data.home.skin.ink2 },
      ),
    ),

    // 网格
    crossAxisCount: data.home.gridColumns,
    childAspectRatio: 0.62,
    mainAxisSpacing: 14.0,
    crossAxisSpacing: 10.0,
    horizontalPadding: 14.0,
    bottomPadding: 110.0,
    children: [
      ...for item in data.home.items:
        Poster(item: item),
    ],
  ),
);

// ---------------------------------------------------------------- 二级分类页

widget PageTab = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    color: 0x00000000,
    margin: [ 0.0, 6.0, 6.0, 6.0 ],
    padding: [ 12.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    child: Text(
      text: args.item.typeName,
      style: {
        color: switch args.item.selected { true: 0xFF6C5CE7, false: data.home.skin.ink2 },
        fontSize: 14.0,
        fontWeight: switch args.item.selected { true: "w700", false: "w400" },
      },
    ),
  ),
);

widget PageOption = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    color: 0x00000000,
    margin: [ 0.0, 4.0, 6.0, 4.0 ],
    padding: [ 10.0, 0.0 ],
    alignment: { x: 0.0, y: 0.0 },
    child: Text(
      text: args.item.name,
      style: {
        color: switch args.item.selected { true: 0xFF6C5CE7, false: data.home.skin.ink },
        fontSize: 13.0,
      },
    ),
  ),
);

widget PageFilters = Column(
  mainAxisSize: "min",
  children: [
    SizedBox(
      height: 42.0,
      child: ListView(
        scrollDirection: "horizontal",
        padding: [ 8.0, 0.0 ],
        children: [
          ...for item in data.home.classes:
            PageTab(item: item),
        ],
      ),
    ),
    ...for group in data.home.filters:
      SizedBox(
        height: 38.0,
        child: ListView(
          scrollDirection: "horizontal",
          padding: [ 8.0, 0.0 ],
          children: [
            ...for option in group.options:
              PageOption(item: option),
          ],
        ),
      ),
  ],
);

widget categoryPage = Container(
  duration: 600,
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: 0.0, y: 0.0 },
      end: { x: 1.0, y: 1.0 },
      colors: switch data.home.skin.id {
        "peach": [ 0xFFFFF5F0, 0xFFFFE0EC, 0xFFE0F0FF ],
        default: [ 0xFF0F0C29, 0xFF302B63, 0xFF24243E ],
      },
    },
  },
  child: Stack(
    fit: "expand",
    children: [
      PeekStickyGrid(
        topPadding: 52.0,
        heroHeight: -1.0,
        hero: PageFilters(),
        pinnedHeight: 0.0,
        pinnedHeader: SizedBoxShrink(),
        sectionHeight: 0.0,
        sectionHeader: SizedBoxShrink(),
        keepScrollWhenEmpty: true,
        onRefresh: event "refresh" {},
        refreshing: data.home.refreshing,
        refreshColor: 0xFF6C5CE7,
        refreshBackground: 0x00000000,
        empty: Center(
          child: Text(
            text: switch data.home.loading { true: "正在载入…", false: "暂无内容" },
            style: { color: data.home.skin.ink2 },
          ),
        ),
        crossAxisCount: data.home.metrics.gridColumns,
        childAspectRatio: data.home.metrics.gridRatio,
        mainAxisSpacing: 16.0,
        crossAxisSpacing: data.home.metrics.gridGap,
        horizontalPadding: data.home.metrics.gridPadding,
        bottomPadding: 24.0,
        children: [
          ...for item in data.home.items:
            Poster(item: item),
        ],
      ),
      Align(
        alignment: { x: 0.0, y: -1.0 },
        child: SafeArea(
          bottom: false,
          child: SizedBox(
            height: 48.0,
            child: Row(
              children: [
                GestureDetector(
                  onTap: event "navigateBack" {},
                  child: Container(
                    width: 48.0,
                    height: 48.0,
                    alignment: { x: 0.0, y: 0.0 },
                    child: Icon(icon: data.home.icons.backIos, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
                  ),
                ),
                Expanded(
                  child: Text(
                    text: data.home.selectedTypeName,
                    maxLines: 1,
                    overflow: "ellipsis",
                    style: { color: data.home.skin.ink, fontSize: 18.0, fontWeight: "w700" },
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    ],
  ),
);
