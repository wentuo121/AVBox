// 清新薄荷：薄荷绿主色调，层叠轮播 + 圆角海报网格 + 毛玻璃吸顶栏。
import core.widgets;
import peek.home;

// ---------------------------------------------------------------- 多风格

widget skins {
  mint:  { name: "清新薄荷", bg: 0xFFF4FBF7, card: 0xFFFFFFFF, ink: 0xFF2A3D34, ink2: 0xFF7A9A8C, accent: 0xFF5BB086 },
  night: { name: "夜色薄荷", bg: 0xFF1A2320, card: 0xFF26312C, ink: 0xFFEDF5F1, ink2: 0xFF93AFA3, accent: 0xFF7ED6AE },
  glow:  { name: "流光", dynamic: true },
} = SizedBoxShrink();

// ---------------------------------------------------------------- 轮播卡片

widget HeroCard = GestureDetector(
  onTap: event "openRecommend" { index: args.index },
  child: Container(
    padding: [ 4.0 ],
    child: ClipRRect(
      borderRadius: [ { x: 18.0 } ],
      child: Stack(
        fit: "expand",
        children: [
          T4Image(
            url: args.item.pic,
            fit: "cover",
            placeholderColor: data.home.skin.card,
          ),
          Container(
            decoration: {
              type: "box",
              gradient: {
                type: "linear",
                begin: { x: 0.0, y: 1.0 },
                end: { x: 0.0, y: 0.5 },
                colors: [ 0xCC000000, 0x00000000 ],
              },
            },
          ),
          Positioned(
            start: 16.0,
            end: 16.0,
            bottom: 16.0,
            child: Column(
              mainAxisSize: "min",
              crossAxisAlignment: "start",
              children: [
                Text(
                  text: args.item.name,
                  maxLines: 2,
                  overflow: "ellipsis",
                  style: { color: 0xFFFFFFFF, fontSize: 20.0, fontWeight: "w800" },
                ),
                Text(
                  text: [ args.item.year, " · ", args.item.typeName ],
                  style: { color: 0xB3FFFFFF, fontSize: 12.0 },
                ),
              ],
            ),
          ),
        ],
      ),
    ),
  ),
);

// ---------------------------------------------------------------- 吸顶栏

widget ApiButton = GestureDetector(
  onTap: event "showApiConfigPicker" {},
  child: Container(
    width: 40.0,
    height: 40.0,
    alignment: { x: 0.0, y: 0.0 },
    child: Icon(icon: 0xF0616, fontFamily: "MaterialIcons", size: 20.0, color: data.home.skin.ink),
  ),
);

widget SearchButton = GestureDetector(
  onTap: event "openSearch" {},
  child: Container(
    width: 40.0,
    height: 40.0,
    alignment: { x: 0.0, y: 0.0 },
    child: Icon(icon: 0xE567, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
  ),
);

widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    padding: [ 14.0, 0.0 ],
    margin: [ 0.0, 8.0, 8.0, 8.0 ],
    alignment: { x: 0.0, y: 0.0 },
    child: Text(
      text: args.item.typeName,
      style: {
        color: switch args.item.selected { true: data.home.skin.accent, false: data.home.skin.ink2 },
        fontSize: 14.0,
        fontWeight: switch args.item.selected { true: "w700", false: "w500" },
      },
    ),
  ),
);

widget PinnedBar = PeekGlass(
  blur: 18.0,
  radius: 0.0,
  tintColor: 0xE6FFFFFF,
  borderColor: 0x1A000000,
  child: Container(
    padding: [ 12.0, 0.0 ],
    child: Column(
      mainAxisSize: "min",
      children: [
        Row(
          children: [
            Expanded(
              child: Text(
                text: data.home.source.name,
                maxLines: 1,
                overflow: "ellipsis",
                style: { color: data.home.skin.ink, fontSize: 16.0, fontWeight: "w700" },
              ),
            ),
            SearchButton(),
            ApiButton(),
          ],
        ),
        SizedBox(
          height: 36.0,
          child: ListView(
            scrollDirection: "horizontal",
            children: [
              ...for item in data.home.classes:
                CategoryChip(item: item),
            ],
          ),
        ),
      ],
    ),
  ),
);

// ---------------------------------------------------------------- 海报网格

widget Poster = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Column(
    crossAxisAlignment: "start",
    children: [
      Expanded(
        child: ClipRRect(
          borderRadius: [ { x: 10.0 } ],
          child: T4Image(
            url: args.item.pic,
            fit: "cover",
            placeholderColor: data.home.skin.card,
          ),
        ),
      ),
      Padding(
        padding: [ 2.0, 6.0, 2.0, 0.0 ],
        child: Text(
          text: args.item.name,
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: data.home.skin.ink, fontSize: 13.0, fontWeight: "w600" },
        ),
      ),
      Padding(
        padding: [ 2.0, 0.0 ],
        child: Text(
          text: args.item.remarks,
          maxLines: 1,
          overflow: "ellipsis",
          style: { color: data.home.skin.ink2, fontSize: 11.0 },
        ),
      ),
    ],
  ),
);

widget Empty = Center(
  child: Text(
    text: switch data.home.loading { true: "正在载入…", false: "暂无内容" },
    style: { color: data.home.skin.ink2 },
  ),
);

// ---------------------------------------------------------------- 首页根

widget root = Container(
  color: data.home.skin.bg,
  duration: 600,
  child: PeekStickyGrid(
    heroHeight: switch data.home.hasRecommend { true: 210.0, false: 0.0 },
    hero: switch data.home.hasRecommend {
      true: Container(
        padding: [ 14.0, 10.0, 14.0, 0.0 ],
        child: PeekCarousel(
          style: "stack",
          viewportFraction: 0.84,
          autoPlay: true,
          interval: 4500,
          showIndicators: true,
          indicatorAlignment: "end",
          indicatorBottom: 4.0,
          activeColor: data.home.skin.accent,
          inactiveColor: 0x4DFFFFFF,
          stackScale: 0.86,
          stackOpacity: 0.5,
          stackOffset: 0.12,
          syncImmersivePalette: true,
          children: [
            ...for item in data.home.home.recommend:
              HeroCard(item: item, index: item.index),
          ],
        ),
      ),
      default: SizedBoxShrink(),
    },
    pinnedHeight: 88.0,
    pinnedHeader: PinnedBar(),
    sectionHeight: 0.0,
    sectionHeader: SizedBoxShrink(),
    onRefresh: event "refresh" {},
    refreshing: data.home.refreshing,
    refreshColor: data.home.skin.accent,
    refreshBackground: data.home.skin.bg,
    empty: Empty(),
    crossAxisCount: data.home.gridColumns,
    childAspectRatio: 0.62,
    mainAxisSpacing: 14.0,
    crossAxisSpacing: 10.0,
    horizontalPadding: 14.0,
    bottomPadding: 110.0,
    children: [
      ...for item in data.home.items:
        Poster(item: item),
    ],
  ),
);

// ---------------------------------------------------------------- 二级分类页

widget PageTab = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Container(
    padding: [ 14.0, 0.0 ],
    margin: [ 0.0, 6.0, 6.0, 6.0 ],
    alignment: { x: 0.0, y: 0.0 },
    child: Text(
      text: args.item.typeName,
      style: {
        color: switch args.item.selected { true: data.home.skin.accent, false: data.home.skin.ink2 },
        fontSize: 14.0,
        fontWeight: switch args.item.selected { true: "w700", false: "w500" },
      },
    ),
  ),
);

widget PageFilter = GestureDetector(
  onTap: event "selectFilter" { key: args.item.filterKey, value: args.item.value },
  child: Container(
    padding: [ 10.0, 0.0 ],
    margin: [ 0.0, 4.0, 6.0, 4.0 ],
    alignment: { x: 0.0, y: 0.0 },
    decoration: {
      type: "box",
      color: switch args.item.selected { true: data.home.skin.accentSoft, false: 0x00000000 },
      borderRadius: [ { x: 12.0 } ],
      border: [ { color: switch args.item.selected { true: data.home.skin.accent, false: data.home.skin.hair }, width: 1.0 } ],
    },
    child: Text(
      text: args.item.name,
      style: {
        color: switch args.item.selected { true: data.home.skin.accent, false: data.home.skin.ink2 },
        fontSize: 13.0,
      },
    ),
  ),
);

widget PageFilters = Column(
  mainAxisSize: "min",
  crossAxisAlignment: "start",
  children: [
    SizedBox(
      height: 42.0,
      child: ListView(
        scrollDirection: "horizontal",
        padding: [ 14.0, 0.0 ],
        children: [
          ...for item in data.home.classes:
            PageTab(item: item),
        ],
      ),
    ),
    ...for group in data.home.filters:
      Padding(
        padding: [ 14.0, 0.0 ],
        child: Column(
          mainAxisSize: "min",
          crossAxisAlignment: "start",
          children: [
            Padding(
              padding: [ 0.0, 4.0, 0.0, 2.0 ],
              child: Text(text: group.name, style: { color: data.home.skin.ink2, fontSize: 12.0 }),
            ),
            Wrap(
              spacing: 4.0,
              runSpacing: 2.0,
              children: [
                ...for option in group.options:
                  PageFilter(item: option),
              ],
            ),
          ],
        ),
      ),
  ],
);

widget categoryPage = Container(
  color: data.home.skin.bg,
  duration: 600,
  child: Stack(
    fit: "expand",
    children: [
      PeekStickyGrid(
        topPadding: 52.0,
        heroHeight: -1.0,
        hero: PageFilters(),
        pinnedHeight: 0.0,
        pinnedHeader: SizedBoxShrink(),
        sectionHeight: 0.0,
        sectionHeader: SizedBoxShrink(),
        keepScrollWhenEmpty: true,
        onRefresh: event "refresh" {},
        refreshing: data.home.refreshing,
        refreshColor: data.home.skin.accent,
        refreshBackground: data.home.skin.bg,
        empty: Empty(),
        crossAxisCount: data.home.metrics.gridColumns,
        childAspectRatio: data.home.metrics.gridRatio,
        mainAxisSpacing: 16.0,
        crossAxisSpacing: data.home.metrics.gridGap,
        horizontalPadding: data.home.metrics.gridPadding,
        bottomPadding: 24.0,
        children: [
          ...for item in data.home.items:
            Poster(item: item),
        ],
      ),
      Align(
        alignment: { x: 0.0, y: -1.0 },
        child: Container(
          color: data.home.skin.bg,
          duration: 600,
          child: SafeArea(
            bottom: false,
            child: SizedBox(
              height: 48.0,
              child: Row(
                children: [
                  GestureDetector(
                    onTap: event "navigateBack" {},
                    child: Container(
                      width: 48.0,
                      height: 48.0,
                      alignment: { x: 0.0, y: 0.0 },
                      child: Icon(icon: 0xE094, fontFamily: "MaterialIcons", size: 22.0, color: data.home.skin.ink),
                    ),
                  ),
                  Expanded(
                    child: Text(
                      text: data.home.selectedTypeName,
                      maxLines: 1,
                      overflow: "ellipsis",
                      style: { color: data.home.skin.ink, fontSize: 18.0, fontWeight: "w700" },
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    ],
  ),
);
