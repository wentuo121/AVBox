// 清爽薄荷：TabBar 风格渐变指示条 + 极简 SectionBar + 海报底部渐变分割线。
import core.widgets;
import peek.home;

// ---------------------------------------------------------------- 多风格

widget skins {
  mint: { name: "清爽薄荷", bg: 0xFFF7F8FA, card: 0xFFFFFFFF, ink: 0xFF1F2937, ink2: 0xFF6B7280, accent: 0xFF4ADE80 },
  ocean: { name: "海盐蓝", bg: 0xFFF0F7FA, card: 0xFFFFFFFF, ink: 0xFF1E3A5F, ink2: 0xFF5A7A9A, accent: 0xFF38BDF8 },
  peach: { name: "蜜桃气泡", bg: 0xFFFFF5F5, card: 0xFFFFFFFF, ink: 0xFF4A2C2E, ink2: 0xFF9A6B6E, accent: 0xFFFF8FA3 },
  glow: { name: "流光", dynamic: true },
} = SizedBoxShrink();

// ================================================================= Hero

widget HeroArt = T4Image(
  url: switch args.item.backdrop { "": args.item.pic, default: args.item.backdrop },
  fit: "cover",
  alignment: switch args.item.backdrop { "": "topCenter", default: "center" },
  placeholderColor: 0x00000000,
  fadeBottom: 0.5,
  drift: true,
);

widget HeroShade = Container(
  decoration: {
    type: "box",
    gradient: {
      type: "linear",
      begin: { x: 0.0, y: -1.0 },
      end: { x: 0.0, y: 1.0 },
      colors: [ 0x44000000, 0x00000000, 0x00000000, 0xFFFFFFFF ],
      stops: [ 0.0, 0.3, 0.65, 1.0 ],
    },
  },
);

widget HeroTitle = switch args.item.titleLogo {
  "": Text(
    text: args.item.name, maxLines: 2, overflow: "ellipsis", textAlign: args.align,
    style: {
      color: 0xFFFFFFFF, fontSize: args.size, fontWeight: "w900",
      height: 1.08, letterSpacing: -0.3,
      shadows: [ { color: 0x99000000, blurRadius: 16.0, offset: { x: 0.0, y: 2.0 } } ],
    },
  ),
  default: Container(
    height: args.height, constraints: { maxWidth: args.maxWidth }, alignment: args.box,
    child: T4Image(url: args.item.titleLogo, fit: "contain", alignment: args.alignment, placeholderColor: 0x00000000),
  ),
};

widget HeroInfoText = Text(
  text: args.text,
  maxLines: 1, overflow: "ellipsis",
  style: { color: 0xBFFFFFFF, fontSize: 11.0, fontWeight: "w600", letterSpacing: 0.4 },
);

widget HeroMeta = Align(
  alignment: { x: 0.0, y: 1.0 },
  child: Padding(
    padding: [ 24.0, 0.0, 24.0, 36.0 ],
    child: Column(
      mainAxisSize: "min", crossAxisAlignment: "center",
      children: [
        HeroTitle(item: args.item, align: "center", size: 26.0, height: 60.0, maxWidth: 280.0, alignment: "bottomCenter", box: { x: 0.0, y: 1.0 }),
        Padding(
          padding: [ 0.0, 8.0, 0.0, 0.0 ],
          child: Row(
            mainAxisSize: "min", crossAxisAlignment: "center",
            children: [
              HeroInfoText(text: args.item.year),
              Padding(padding: [ 6.0, 0.0 ], child: Text(text: "·", style: { color: 0x66FFFFFF, fontSize: 12.0 })),
              HeroInfoText(text: args.item.typeName),
              switch args.item.remarks {
                "": SizedBoxShrink(),
                default: Padding(
                  padding: [ 6.0, 0.0 ],
                  child: Row(mainAxisSize: "min", crossAxisAlignment: "center", children: [
                    Padding(padding: [ 0.0, 0.0, 6.0, 0.0 ], child: Text(text: "·", style: { color: 0x66FFFFFF, fontSize: 12.0 })),
                    HeroInfoText(text: args.item.remarks),
                  ]),
                ),
              },
            ],
          ),
        ),
      ],
    ),
  ),
);

widget HeroSlide = GestureDetector(
  onTap: event "openRecommend" { index: args.item.index },
  child: Container(
    margin: [ 6.0, 6.0 ], clipBehavior: "none",
    child: ClipRRect(
      borderRadius: [ { x: 20.0 } ],
      child: Stack(
        fit: "expand",
        children: [ HeroArt(item: args.item), HeroShade(), HeroMeta(item: args.item) ],
      ),
    ),
  ),
);

// ================================================================= 分类胶囊：TabBar 风格 + 渐变指示条

widget CategoryChip = GestureDetector(
  onTap: event "selectType" { typeId: args.item.typeId },
  child: Column(
    mainAxisSize: "min", crossAxisAlignment: "center",
    children: [
      Container(
        padding: [ 4.0, 0.0 ],
        child: Text(
          text: args.item.typeName, maxLines: 1, overflow: "ellipsis",
          style: {
            color: switch args.item.selected { true: data.home.skin.accent, false: data.home.skin.ink2 },
            fontSize: 13.0,
            fontWeight: switch args.item.selected { true: "w700", false: "w500" },
            height: 1.0,
          },
        ),
      ),
      Container(
        width: switch args.item.selected { true: 48.0, false: 0.0 },
        height: 3.0,
        margin: [ 0.0, 6.0, 0.0, 0.0 ],
        decoration: switch args.item.selected {
          true: {
            type: "box",
            gradient: {
              type: "linear",
              begin: { x: 0.0, y: 0.0 }, end: { x: 1.0, y: 0.0 },
              colors: [ data.home.skin.accent, 0x00000000 ],
            },
            borderRadius: [ { x: 2.0 } ],
          },
          default: { type: "box", color: 0x00000000 },
        },
      ),
    ],
  ),
);

widget CategoryHeader = Container(
  color: 0x00000000,
  height: 52.0,
  child: ListView(
    scrollDirection: "horizontal",
    padding: [ 16.0, 0.0 ],
    children: [
      ...for item in data.home.classes:
        Padding(padding: [ 0.0, 8.0, 8.0, 8.0 ], child: CategoryChip(item: item)),
    ],
  ),
);

// ================================================================= SectionBar：极简站源名 + 筛选

widget TinyIconBtn = GestureDetector(
  onTap: args.action,
  child: Container(
    width: 36.0, height: 36.0,
    decoration: {
      type: "box",
      color: 0x08000000,
      borderRadius: [ { x: 10.0 } ],
    },
    alignment: { x: 0.0, y: 0.0 },
    child: Icon(icon: args.icon, fontFamily: "MaterialIcons", size: 18.0, color: data.home.skin.ink),
  ),
);

widget SectionBar = Container(
  color: 0x00000000,
  padding: [ 16.0, 4.0, 16.0, 6.0 ],
  child: Row(
    children: [
      Expanded(child: Column(
        mainAxisSize: "min", crossAxisAlignment: "start",
        children: [
          Row(
            mainAxisSize: "min",
            children: [
              Container(width: 3.0, height: 14.0, margin: [ 0.0, 0.0, 8.0, 0.0 ],
                decoration: { type: "box", color: data.home.skin.accent, borderRadius: [ { x: 1.5 } ] }),
              Text(text: data.home.source.name, maxLines: 1, overflow: "ellipsis",
                style: { color: data.home.skin.ink, fontSize: 16.0, fontWeight: "w800" }),
            ],
          ),
          Padding(padding: [ 11.0, 2.0, 0.0, 0.0 ],
            child: Text(text: [ data.home.totalLabel, " 部内容" ],
              maxLines: 1, overflow: "ellipsis",
              style: { color: data.home.skin.ink2, fontSize: 10.0, letterSpacing: 0.3 })),
        ],
      )),
      TinyIconBtn(icon: data.home.icons.filter, action: event "toggleFilters" {}),
    ],
  ),
);

// ================================================================= 海报卡片：底部渐变分割线

widget PosterCard = GestureDetector(
  onTap: event "openItem" { index: args.item.index },
  onLongPress: event "longPressItem" { index: args.item.index },
  child: Container(
    decoration: {
      type: "box",
      borderRadius: [ { x: 14.0 } ],
      color: 0xFFFFFFFF,
      boxShadow: [ { color: 0x14000000, blurRadius: 12.0, offset: { x: 0.0, y: 4.0 } } ],
    },
    child: Column(
      crossAxisAlignment: "start",
      children: [
        Expanded(child: ClipRRect(
          borderRadius: [ { x: 14.0 }, { x: 14.0, y: 0.0 } ],
          child: T4Image(url: args.item.pic),
        )),
        Padding(padding: [ 10.0, 6.0, 10.0, 0.0 ], child: Text(
          text: args.item.name, maxLines: 1, overflow: "ellipsis",
          style: { color: data.home.skin.ink, fontSize: 12.0, fontWeight: "w700" },
        )),
        Padding(padding: [ 10.0, 0.0, 10.0, 6.0 ], child: Text(
          text: args.item.remarks, maxLines: 1, overflow: "ellipsis",
          style: { color: data.home.skin.ink2, fontSize: 10.0 },
        )),
        Container(height: 2.0, margin: [ 12.0, 0.0, 12.0, 10.0 ],
          decoration: {
            type: "box",
            gradient: {
              type: "linear",
              begin: { x: 0.0, y: 0.0 }, end: { x: 1.0, y: 0.0 },
              colors: [ data.home.skin.accent, 0x16000000, 0x00000000 ],
            },
            borderRadius: [ { x: 1.0 } ],
          }),
      ],
    ),
  ),
);

// ================================================================= 空态 & 根

widget EmptyState = switch data.home.loading {
  true: Center(child: Text(text: "正在载入…", style: { color: data.home.skin.ink2, fontSize: 13.0 })),
  false: Center(child: Text(text: "暂无内容", style: { color: data.home.skin.ink2, fontSize: 13.0 })),
};

widget root = Container(
  color: data.home.skin.bg,
  duration: 700,
  child: PeekStickyGrid(
    heroHeight: switch data.home.hasRecommend { true: switch data.home.gridColumns { 3: 220.0, default: 260.0 }, false: 0.0 },
    hero: switch data.home.hasRecommend {
      true: PeekCarousel(
        autoPlay: true, style: "stack", viewportFraction: 0.84,
        showIndicators: true, indicatorAlignment: "end",
        indicatorInset: 24.0, indicatorBottom: 14.0,
        activeColor: data.home.skin.accent, inactiveColor: 0x26000000,
        stackScale: 0.86, stackOpacity: 0.5, stackOffset: 0.12,
        syncImmersivePalette: true, interval: 4500,
        children: [ ...for item in data.home.home.recommend: HeroSlide(item: item) ],
      ),
      false: SizedBoxShrink(),
    },
    pinnedHeight: 52.0,
    pinnedHeader: CategoryHeader(),
    sectionHeight: 68.0,
    sectionHeader: SectionBar(),
    onRefresh: event "refresh" {}, refreshing: data.home.refreshing,
    refreshColor: data.home.skin.accent, refreshBackground: 0x00000000,
    crossAxisCount: data.home.gridColumns, childAspectRatio: 0.72,
    mainAxisSpacing: 14.0, crossAxisSpacing: 10.0,
    horizontalPadding: 14.0, bottomPadding: 106.0,
    empty: EmptyState(),
    children: [ ...for item in data.home.items: PosterCard(item: item) ],
  ),
);
